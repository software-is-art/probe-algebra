# bridged-bool — a demonstration prover emission: the Boolean fragment as finite
# operator tables (a table IS an eval function; see `discover::bridge`).
#
# This file is the INPUT artifact — committed verbatim, standing for the kernel's
# export. `spec/bridged-bool.spec` and `spec/bridged-bool.obligations.spec` are DERIVED
# from it by the freeze path; edit THIS file (as the prover would re-emit it) and
# regenerate, never the derived locks.
#
# format: `elements:` names the carrier in index order; an `op token/arity:` table is
# row-major (the first argument fixes the row); `proved:` lines carry the prover's own
# certificates in the declaration vocabulary (`expects { ... }`'s words).
theory: bridged-bool
elements: false true
op false/0: false
op true/0: true
op not/1: true false
op and/2: false false | false true
op or/2: false true | true true
op xor/2: false true | true false
proved: commutative and
proved: associative and
proved: identity and true
proved: commutative or
