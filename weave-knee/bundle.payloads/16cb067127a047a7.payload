/// The only model-calling path: weave, judge, reconstruct, record. Existing trials
/// are kept — a sweep is resumable, and re-measuring means deleting the trial
/// deliberately.
fn sweep(args: &[String]) -> Result<(), String> {
    let weaver = flag(args, "--weaver")?;
    let judge = flag(args, "--judge")?;
    let fanouts = list(&flag(args, "--fanouts")?)?;
    let seeds = list(&flag(args, "--seeds")?)?;
    let dir = root().join("trials").join(sanitize(&weaver));
    for &fanout in &fanouts {
        for &seed in &seeds {
            let path = dir.join(format!("k{fanout:02}-s{seed}.trial"));
            if path.exists() {
                println!("have {}", path.display());
                continue;
            }
            let t = corpus::trial(fanout, seed as u64);
            println!("weaving fanout {fanout} seed {seed} with {weaver} ...");
            let narrative = call(&weaver, &prompt::weave(&t))?.trim().to_string();
            println!("judging with {judge} ...");
            let reading = record::read_judge(&call(&judge, &prompt::judge(&t, &narrative))?)?;
            println!("reconstructing the topology with {judge} ...");
            let edges =
                record::parse_edges(&call(&judge, &prompt::reconstruct(&t, &narrative))?)?;
            let rec = record::Record {
                fanout,
                seed: seed as u64,
                weaver: weaver.clone(),
                judge: judge.clone(),
                quality: reading.quality,
                narrative,
                verdicts: reading.verdicts,
                stated: reading.stated,
                edges,
            };
            // an incomplete judge census refuses BEFORE anything is written
            let scored = weave_knee::score::score(&t, &rec)?;
            std::fs::create_dir_all(&dir).map_err(|e| format!("{}: {e}", dir.display()))?;
            std::fs::write(&path, record::render(&rec))
                .map_err(|e| format!("{}: {e}", path.display()))?;
            println!(
                "recorded {} — relations {:.2}, gain {:.2}, e-foil {:.2}, topo {:.2}/{:.2}, \
                 quality {}",
                path.display(),
                scored.relation_cov,
                scored.gain,
                scored.e_foil_rej,
                scored.topo_recall,
                scored.topo_prec,
                scored.quality
            );
        }
    }
    println!("sweep done — run `knee freeze` and ratify the spec diff.");
    Ok(())
}
